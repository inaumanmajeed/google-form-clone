{
  "name": "google-form-clone",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "server": "npm run start --workspace=server",
    "client": "npm run dev --workspace=client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "i-all": "npm install --workspace=client && npm install --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
